# ==========================================
# IncuBrix B-Roll Video Engine Configuration
# ==========================================

# Environment & Server
ENVIRONMENT=development
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Security & Idempotency
IDEMPOTENCY_TTL_SECONDS=86400
HMAC_SECRET=incubrix-super-secret-hmac-key
MAX_UPLOAD_SIZE_BYTES=104857600
MAX_AUDIO_DURATION_SECONDS=600.0
REQUEST_TIMEOUT_SECONDS=30

# Storage: "local" or "s3"
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage_root

# MinIO / S3 Settings (used when STORAGE_BACKEND=s3)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=incubrix-videos
S3_REGION=us-east-1

# Workers & Concurrency
REDIS_URL=redis://localhost:6379/0
USE_INTERNAL_WORKER=true
MAX_CONCURRENT_JOBS=4

# Speech & AI Models
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
DEFAULT_TTS_PROVIDER=edge_tts
DEFAULT_VOICE=en-IN-female
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2
EMBEDDINGS_DEVICE=cpu

# Footage Providers (Optional keys for real external APIs; mock/local fallback enabled by default)
PEXELS_API_KEY=
PIXABAY_API_KEY=
ENABLE_MOCK_FALLBACK=true

# FFmpeg Paths
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
DEFAULT_FPS=30
DEFAULT_VIDEO_BITRATE=4000k
DEFAULT_AUDIO_BITRATE=192k
